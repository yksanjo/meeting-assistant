{
  // markdownlint-cli2 configuration
  "config": {
    "default": true,
    // Long lines are fine in prose and tables
    "MD013": false,
    // Allow duplicate headings as long as they are not siblings
    "MD024": { "siblings_only": true },
    // Allow common inline HTML used in docs
    "MD033": { "allowed_elements": ["br", "img", "details", "summary", "sub", "sup", "kbd", "a", "p", "div"] }
  },
  "ignores": ["node_modules/**", ".next/**", "dist/**", "build/**"]
}
